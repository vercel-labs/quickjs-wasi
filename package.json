{
  "name": "quickjs-wasi",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.3",
  "description": "Snapshotable JavaScript runtime via WebAssembly. QuickJS-NG compiled to WASM with snapshot/restore support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "default": "./dist/url.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "default": "./dist/encoding.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "default": "./dist/base64.js"
    },
    "./dom-exception": {
      "types": "./dist/dom-exception.d.ts",
      "default": "./dist/dom-exception.js"
    },
    "./queue-microtask": {
      "types": "./dist/queue-microtask.d.ts",
      "default": "./dist/queue-microtask.js"
    },
    "./structured-clone": {
      "types": "./dist/structured-clone.d.ts",
      "default": "./dist/structured-clone.js"
    }
  },
  "files": [
    "dist",
    "quickjs.wasm",
    "extensions/url/url.so",
    "extensions/encoding/encoding.so",
    "extensions/base64/base64.so",
    "extensions/dom-exception/dom-exception.so",
    "extensions/queue-microtask/queue-microtask.so",
    "extensions/structured-clone/structured-clone.so"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/vercel-labs/quickjs-wasi.git"
  },
  "scripts": {
    "build:wasm": "make",
    "build:ts": "tsc",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "test": "vitest run",
    "bench": "bun run bench/url-benchmark.ts",
    "bench:encoding": "bun run bench/encoding-benchmark.ts",
    "bench:base64": "bun run bench/base64-benchmark.ts",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "pnpm run build && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^22.0.0",
    "bun": "^1.3.10",
    "core-js-pure": "^3.48.0",
    "degenerator": "^5.0.1",
    "esbuild": "^0.27.3",
    "fast-text-encoding": "^1.0.6",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
